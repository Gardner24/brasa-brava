# =============================================================
# Brasa Brava — Variables de entorno
# Copiar a .env y completar valores reales para desarrollo local.
# Nunca subir .env al repositorio.
# =============================================================

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brasa_brava
POSTGRES_USER=brasa_admin
POSTGRES_PASSWORD=change_me_in_local_env
# Rol con permisos limitados con el que corre el backend (sin UPDATE/DELETE en audit_log)
POSTGRES_APP_USER=brasa_app
POSTGRES_APP_PASSWORD=change_me_in_local_env

DATABASE_URL=postgresql://brasa_admin:change_me_in_local_env@localhost:5432/brasa_brava?schema=public
DATABASE_URL_APP=postgresql://brasa_app:change_me_in_local_env@localhost:5432/brasa_brava?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# JWT — generar con: openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_random_64_byte_base64
JWT_REFRESH_SECRET=replace_with_different_random_64_byte_base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Email transaccional (MailHog en dev) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Brasa Brava <no-reply@brasabrava.local>"

# --- Frontend ----------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# --- Tenant inicial (seed) ---------------------------------------------------
SEED_TENANT_CODE=BRASA_BRAVA
SEED_TENANT_NAME="Brasa Brava"
SEED_ADMIN_EMAIL=admin@brasabrava.local
SEED_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
SEED_EXCEL_PATH=../../Plantilla Mauricio final.xlsm
